{
  "name": "vidlens-mcp",
  "mcpName": "io.github.thatsrajan/vidlens-mcp",
  "version": "1.3.0",
  "description": "VidLens MCP — video as a queryable local asset for AI agents. 45 tools across YouTube, social video URLs, local media, semantic search, transcription, and visual search.",
  "repository": {
    "type": "git",
    "url": "https://github.com/thatsrajan/vidlens-mcp.git"
  },
  "homepage": "https://github.com/thatsrajan/vidlens-mcp",
  "bugs": {
    "url": "https://github.com/thatsrajan/vidlens-mcp/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "vidlens-mcp": "dist/cli.js"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "!dist/**/*.map",
    "!dist/test/**",
    "!dist/**/*conflicted copy*",
    "plugins/**",
    ".agents/plugins/marketplace.json",
    "server.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "setup": "npm run build --silent && node dist/cli.js setup",
    "doctor": "npm run build --silent && node dist/cli.js doctor",
    "update-deps": "npm run build --silent && node dist/cli.js update-deps",
    "postinstall": "node -e \"console.log('\\nVidLens MCP installed. From a checkout run: npm run setup. For the global command run: npm install -g .\\n')\"",
    "start": "node dist/cli.js",
    "test": "npm run build && node --test dist/test/*.test.js",
    "release:verify": "npm test && npm pack --dry-run",
    "release:publish": "npm test && npm publish --access public",
    "smoke": "node dist/scripts/smoke.js",
    "smoke:dry": "node dist/scripts/smoke.js --dry-run"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "youtube",
    "tiktok",
    "instagram",
    "twitter",
    "x",
    "local-video",
    "youtube-api",
    "youtube-transcript",
    "video-intelligence",
    "video-analysis",
    "model-context-protocol",
    "yt-dlp",
    "semantic-search",
    "sentiment-analysis"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@google/genai": "^1.45.0",
    "@modelcontextprotocol/sdk": "^1.17.4",
    "execa": "^9.6.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2"
  }
}
