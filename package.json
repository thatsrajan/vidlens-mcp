{
  "name": "vidlens-mcp",
  "mcpName": "io.github.thatsrajan/vidlens-mcp",
  "version": "1.5.0",
  "description": "VidLens MCP — 47 tools that turn online and local video into a queryable asset for AI agents.",
  "repository": {
    "type": "git",
    "url": "https://github.com/thatsrajan/vidlens-mcp.git"
  },
  "homepage": "https://github.com/thatsrajan/vidlens-mcp",
  "bugs": {
    "url": "https://github.com/thatsrajan/vidlens-mcp/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "vidlens-mcp": "dist/cli.js"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "!dist/**/*.map",
    "!dist/test/**",
    "!dist/**/*conflicted copy*",
    "plugins/**",
    ".agents/plugins/marketplace.json",
    ".agents/skills/**",
    "server.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "setup": "npm run build --silent && node dist/cli.js setup",
    "doctor": "npm run build --silent && node dist/cli.js doctor",
    "update-deps": "npm run build --silent && node dist/cli.js update-deps",
    "postinstall": "node -e \"console.log('\\nVidLens MCP installed. Run: npx vidlens-mcp setup. Start the server with: npx vidlens-mcp serve. Docs: https://github.com/thatsrajan/vidlens-mcp\\n')\"",
    "start": "node dist/cli.js",
    "test": "npm run build && node --test dist/test/*.test.js",
    "release:verify": "npm test && npm pack --dry-run",
    "release:publish": "npm test && npm publish --access public",
    "smoke": "node dist/scripts/smoke.js",
    "smoke:dry": "node dist/scripts/smoke.js --dry-run"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "youtube",
    "tiktok",
    "instagram",
    "twitter",
    "x",
    "local-video",
    "youtube-api",
    "youtube-transcript",
    "video-intelligence",
    "video-analysis",
    "model-context-protocol",
    "yt-dlp",
    "semantic-search",
    "sentiment-analysis",
    "social-search",
    "scrapecreators"
  ],
  "author": "Rajan",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@google/genai": "^1.45.0",
    "@modelcontextprotocol/sdk": "^1.17.4",
    "execa": "^9.6.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2"
  }
}
