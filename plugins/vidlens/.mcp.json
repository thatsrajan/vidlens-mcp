{
  "profiles": {
    "dev": {
      "mcpServers": {
        "vidlens-mcp": {
          "command": "node",
          "args": [
            "../../dist/cli.js",
            "serve"
          ],
          "cwd": "."
        }
      }
    },
    "release": {
      "mcpServers": {
        "vidlens-mcp": {
          "command": "npx",
          "args": [
            "-y",
            "vidlens-mcp",
            "serve"
          ]
        }
      }
    }
  },
  "mcpServers": {
    "vidlens-mcp": {
      "command": "npx",
      "args": [
        "-y",
        "vidlens-mcp",
        "serve"
      ]
    }
  }
}
